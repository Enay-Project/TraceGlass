#include <windows.h>
#include "resource.h"
#include "version.h"

IDR_MANIFEST RT_MANIFEST "traceglass.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION TRACEGLASS_VERSION_MAJOR,TRACEGLASS_VERSION_MINOR,TRACEGLASS_VERSION_PATCH,0
 PRODUCTVERSION TRACEGLASS_VERSION_MAJOR,TRACEGLASS_VERSION_MINOR,TRACEGLASS_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "TraceGlass Contributors\0"
            VALUE "FileDescription", "Native Windows behavioral telemetry viewer\0"
            VALUE "FileVersion", TRACEGLASS_VERSION_STRING_A "\0"
            VALUE "InternalName", "TraceGlass\0"
            VALUE "OriginalFilename", "TraceGlass.exe\0"
            VALUE "ProductName", "TraceGlass\0"
            VALUE "ProductVersion", TRACEGLASS_VERSION_STRING_A "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
