#ifndef TRACEGLASS_VERSION_H
#define TRACEGLASS_VERSION_H

/* CMake project() is the single source of truth for application versioning. */
#define TRACEGLASS_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define TRACEGLASS_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define TRACEGLASS_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define TRACEGLASS_VERSION_STRING L"@PROJECT_VERSION@"
#define TRACEGLASS_VERSION_STRING_A "@PROJECT_VERSION@"

#endif
